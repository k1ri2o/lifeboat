{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lifeboat",
  "version": "0.1.12",
  "identifier": "org.lifeboat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Lifeboat", "label": "main", "width": 760, "height": 640, "minWidth": 520, "minHeight": 480 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
